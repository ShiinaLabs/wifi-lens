    "observation.diagnosis.congested.message_fmt": {
      "comment": "Congested channel with details",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal %1$lld hat %2$lld APs in der Nähe. Erwäge %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel %1$lld has %2$lld nearby APs. Consider %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El canal %1$lld tiene %2$lld AP cercanos. Considera %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le canal %1$lld compte %2$lld AP proches. Envisage %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネル %1$lld には近隣 %2$lld 件の AP があります。%3$@ を検討してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信道 %1$lld 附近有 %2$lld 个 AP。建议考虑 %3$@。"
          }
        }
      }
    },
