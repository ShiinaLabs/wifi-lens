        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu veux partager un résultat ou signaler un problème ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を共有したり、問題を報告したりしますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想分享测试结果，或发现了问题？"
