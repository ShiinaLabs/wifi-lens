    "observation.diagnosis.ok.message": {
      "comment": "General advice",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Verbindung verbessern, indem du näher zum Router gehst oder den Kanal wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You could improve by moving closer to the router or switching channels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes mejorar acercándote al router o cambiando de canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourrais améliorer ta connexion en te rapprochant du routeur ou en changeant de canal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーターに近づくか、チャンネルを切り替えると改善できる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近路由器或切换信道可能会改善连接。"
          }
        }
      }
    },
