    "settings.mcp.description": {
      "comment": "Description of the MCP server feature",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Wi-Fi-Scandaten als lokale HTTP-API für MCP-kompatible KI-Tools wie Codex Desktop und Claude Desktop bereitstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose current Wi-Fi scan data as a local HTTP API for MCP-compatible AI tools such as Codex Desktop and Claude Desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expone datos actuales de escaneo Wi‑Fi como una API HTTP local para herramientas de IA compatibles con MCP, como Codex Desktop y Claude Desktop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose les données de scan Wi-Fi actuelles sous forme d'API HTTP locale pour les outils IA compatibles MCP tels que Codex Desktop et Claude Desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の Wi-Fi スキャンデータを、Codex Desktop や Claude Desktop などの MCP 互換 AI ツール向けのローカル HTTP API として公開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前 Wi-Fi 扫描数据暴露为本地 HTTP API，供 Codex Desktop、Claude Desktop 等 MCP 兼容 AI 工具查询。"
          }
        }
      }
    },
