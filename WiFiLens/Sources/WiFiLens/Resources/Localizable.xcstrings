    "settings.appearance.overview_style_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow macOS Reduce Motion, always show the 3D globe, or always show the static Equal Earth map."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS „Bewegung reduzieren“ folgen, immer den 3D-Globus anzeigen oder immer die statische Equal-Earth-Karte verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue Reducir movimiento de macOS, muestra siempre el globo 3D o muestra siempre el mapa estático Equal Earth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez la fonction Réduire les mouvements de macOS, affichez toujours le globe 3D ou affichez toujours la carte Equal Earth statique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の「視差効果を減らす」に従うか、3D 地球または静的な Equal Earth 地図を常に表示します。"
          }
        },
        "zh-Hans": {
