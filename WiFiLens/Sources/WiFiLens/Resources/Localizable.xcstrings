    "apRadar.description": {
      "comment": "AP Radar feature description on the idle page",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Zugangspunkt aus. WiFi Lens verfolgt dessen Signalstärke und spielt sanfte Impulse, die schneller werden, je stärker das Signal wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an access point and WiFi Lens will track its signal strength, playing soft pulses that speed up as the signal gets stronger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un punto de acceso y WiFi Lens rastreará su intensidad de señal, reproduciendo pulsos suaves que se aceleran a medida que la señal se fortalece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne un point d'accès et WiFi Lens suivra sa puissance de signal en diffusant de légères impulsions qui s'accélèrent à mesure que le signal se renforce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスポイントを選択すると、WiFi Lens がその信号強度を追跡し、信号が強くなるほど速くなる柔らかいパルス音を再生します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个接入点，WiFi Lens 将持续追踪其信号强度，并随着信号增强播放更密集的柔和提示音。"
          }
        }
      }
    },
    "apRadar.disclaimer": {
      "comment": "AP Radar disclaimer about RSSI-only guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der AP-Radar liefert Hinweise auf Basis der empfangenen Signalstärke. Er kann die tatsächliche Richtung oder genaue Entfernung eines Zugangspunkts nicht bestimmen. Wände, Reflexionen, die Geräteausrichtung und Funkstörungen können das Ergebnis beeinflussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AP Radar provides guidance based on received signal strength. It cannot determine an access point’s actual direction or precise distance. Walls, reflections, device orientation, and wireless interference may affect the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Radar AP ofrece orientación según la intensidad de la señal recibida. No puede determinar la dirección real ni la distancia exacta de un punto de acceso. Las paredes, los reflejos, la orientación del dispositivo y las interferencias inalámbricas pueden afectar al resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AP Radar fournit des indications basées sur la puissance du signal reçu. Il ne peut pas déterminer la direction réelle ni la distance précise d'un point d'accès. Les murs, réflexions, l'orientation de l'appareil et les interférences sans fil peuvent affecter le résultat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APレーダーは受信信号強度をもとに補助的な情報を提供します。アクセスポイントの正確な方向や距離を特定することはできません。壁、電波の反射、デバイスの向き、無線干渉などが結果に影響する場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AP 雷达根据接收信号强度提供辅助提示，无法判断接入点的真实方向或精确距离。墙体、反射、设备姿态和无线干扰都可能影响结果。"
          }
        }
      }
    },
    "apRadar.easterEgg.unlocked": {
