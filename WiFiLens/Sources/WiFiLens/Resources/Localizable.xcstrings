    "apRadar.audio.failed": {
      "comment": "Non-blocking message shown when AP Radar audio cannot be initialized",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton ist nicht verfügbar. Die Signalverfolgung läuft ohne Audio weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound is unavailable. RSSI tracking continues without audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido no está disponible. El seguimiento de RSSI continúa sin audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son n'est pas disponible. Le suivi RSSI continue sans audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンドを利用できません。音声なしで RSSI の追跡を続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用声音，将继续进行 RSSI 追踪。"
          }
        }
      }
    },
