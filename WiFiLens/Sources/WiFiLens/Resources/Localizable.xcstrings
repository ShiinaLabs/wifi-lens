    "wifi_calling.help.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is still being validated across carriers and networks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion wird noch mit verschiedenen Anbietern und Netzwerken validiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función todavía se está validando con distintos operadores y redes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonctionnalité est encore en cours de validation selon les opérateurs et les réseaux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能は現在、さまざまな通信事業者とネットワークで検証中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能仍在不同运营商和网络环境中验证。"
          }
        }
      }
    },
    "wifi_calling.help.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It checks whether this Mac can discover and reach a carrier Wi-Fi Calling gateway over the current network path. A response does not confirm that Wi-Fi Calling is enabled for your number, that IMS is registered, or that a call will work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung stellt fest, ob dieser Mac das Wi-Fi-Calling-Gateway eines Anbieters über den aktuellen Netzwerkpfad finden und erreichen kann. Eine Antwort bestätigt nicht, dass Wi-Fi Calling für deine Rufnummer aktiviert ist, IMS registriert ist oder ein Anruf funktioniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si este Mac puede descubrir y alcanzar la puerta de enlace de Wi-Fi Calling de un operador a través de la ruta de red actual. Una respuesta no confirma que Wi-Fi Calling esté activado para tu número, que IMS esté registrado ni que una llamada vaya a funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification détermine si ce Mac peut découvrir et joindre la passerelle Wi-Fi Calling d’un opérateur via le chemin réseau actuel. Une réponse ne confirme pas que Wi-Fi Calling est activé pour ton numéro, qu’IMS est enregistré ni qu’un appel fonctionnera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のネットワーク経路で、このMacが通信事業者のWi-Fi Callingゲートウェイを検出して到達できるかを確認します。応答があっても、あなたの番号でWi-Fi Callingが有効、IMSが登録済み、または通話できることを保証するものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能检查这台 Mac 能否通过当前网络路径发现并到达运营商的 Wi-Fi Calling 网关。收到响应不代表你的号码已开通 Wi-Fi Calling、IMS 已注册，或通话一定可用。"
          }
        }
      }
    },
    "wifi_calling.help.feedback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a result to share or found an issue?"
