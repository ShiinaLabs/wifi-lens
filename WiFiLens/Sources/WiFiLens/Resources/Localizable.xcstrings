            "state": "translated",
            "value": "このプローブ中にネットワークルートが変化しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测过程中网络路由发生了变化。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
