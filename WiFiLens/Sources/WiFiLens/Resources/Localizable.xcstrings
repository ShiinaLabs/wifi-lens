    "roaming.overwrite.message": {
      "comment": "Warning that starting a new roaming test will discard current session data",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Starten eines neuen Roaming-Tests verwirft die aktuellen Sitzungsdaten. Speichere vor dem Fortfahren, wenn du sie behalten möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting a new roaming test will discard the current session data. Save before continuing if you want to keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar una nueva prueba de roaming descartará los datos de la sesión actual. Guarda antes de continuar si quieres conservarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lancement d'un nouveau test d'itinérance supprimera les données de session actuelles. Enregistre avant de continuer si tu souhaites les conserver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいローミングテストを開始すると、現在のセッションデータは破棄されます。保存する場合は先に保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新漫游测试将丢弃当前会话数据。如需保留，请先保存。"
          }
        }
      }
    },
