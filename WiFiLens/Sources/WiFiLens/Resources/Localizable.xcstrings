        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cobertura de observación no está disponible o está incompleta. Los hallazgos siguientes se basan únicamente en agrupaciones de eventos registrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couverture d'observation est indisponible ou incomplète. Les constats ci-dessous reposent uniquement sur les groupes présents dans les événements enregistrés."
