    "apRadar.empty.description": {
      "comment": "Empty state guidance when no access points were found",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass Wi-Fi eingeschaltet ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure Wi-Fi is turned on, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que el Wi-Fi esté activado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assure-toi que le Wi-Fi est activé, puis réessaie."
          }
        },
        "ja": {
