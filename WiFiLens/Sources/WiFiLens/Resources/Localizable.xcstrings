    "permission.location.services_required_message": {
      "comment": "Alert message explaining why Location Services is required",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortungsdienstberechtigung ist erforderlich, um Wi‑Fi-Netzwerknamen zu lesen. Bitte aktiviere sie in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services permission is required to read Wi-Fi network names. Please enable it in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de Servicios de Ubicación para leer nombres de red Wi‑Fi. Habilítalo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation des services de localisation est requise pour lire les noms des réseaux Wi-Fi. Active-la dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi ネットワーク名の読み取りには位置情報サービスの権限が必要です。システム設定で有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Wi-Fi 网络名称需要定位服务权限。请在系统设置中开启。"
          }
        }
      }
